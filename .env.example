# Copier ce fichier en .env (local) ou définir ces variables sur Render > Environment.

# Obligatoire en production : longue chaîne aléatoire, différente du local
SECRET_KEY=change-moi
# 1 en local ; en production laisser vide (désactivé automatiquement sur Render)
DJANGO_DEBUG=1

# Email (OTP d'inscription) — sans mot de passe, les emails s'affichent dans la console
EMAIL_HOST_USER=adresse@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-application-google
# DEFAULT_FROM_EMAIL=Durama <adresse@gmail.com>

# Optionnel
# DJANGO_ALLOWED_HOSTS=api.mondomaine.com
# CORS_ALLOWED_ORIGINS=https://www.mondomaine.com
# SWAGGER_PUBLIC=1
# SERVE_MEDIA=1
# JWT_ACCESS_HEURES=24
# JWT_REFRESH_JOURS=7
# THROTTLE_CONNEXION=10/min

# PostgreSQL (les DEUX sont nécessaires, + ajouter psycopg[binary] à requirements.txt)
# USE_POSTGRES=1
# DATABASE_URL=postgres://user:motdepasse@hote:5432/durama
